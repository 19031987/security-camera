<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/event_detail_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <TextView
            android:id="@+id/tvDetailTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/on_surface_muted"
            tools:text="Oct 31, 2026 14:22:05" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDetailImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@color/black"
            android:contentDescription="@string/cd_event_screenshot"
            android:scaleType="fitCenter"
            app:shapeAppearance="@style/ShapeAppearance.SecurityCam.Thumbnail" />

        <TextView
            android:id="@+id/tvDetailMotionScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/primary"
            tools:text="Motion Score: 88%" />

        <TextView
            android:id="@+id/tvDetailRecognized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/status_armed"
            android:visibility="gone"
            tools:text="Recognised: Asha"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipDetailSms"
                style="@style/Widget.SecurityCam.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                tools:text="SMS: Sent" />

            <TextView
                android:id="@+id/chipDetailEmail"
                style="@style/Widget.SecurityCam.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Email: Sent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailEventId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.SecurityCam.Supporting"
            android:textIsSelectable="true"
            tools:text="Event ID: 3a1b4c-9f8e" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayClip"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_play_clip"
            android:visibility="gone"
            app:icon="@drawable/ic_videocam"
            app:iconGravity="textStart"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteEventDetail"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="@string/action_delete"
                android:textColor="@color/status_alert"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/status_alert"
                app:strokeColor="@color/status_alert" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareScreenshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="@string/action_share_image"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
