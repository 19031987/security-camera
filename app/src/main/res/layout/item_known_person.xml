<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_sm"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPersonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/on_surface"
                tools:text="Asha" />

            <TextView
                android:id="@+id/tvPersonSamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecurityCam.Supporting"
                tools:text="3 face samples" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemovePerson"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/status_alert" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
