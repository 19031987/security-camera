<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivReceivedPicture"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:background="@drawable/thumbnail_placeholder"
            android:contentDescription="@string/cd_alert_picture"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.SecurityCam.Thumbnail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceivedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/on_surface"
                tools:text="Person at your door" />

            <TextView
                android:id="@+id/tvReceivedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SecurityCam.Supporting"
                tools:text="Nov 10, 2026 14:22:05" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
