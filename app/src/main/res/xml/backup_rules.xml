<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include non-sensitive settings and database -->
    <include domain="sharedpref" path="security_cam_settings.xml" />
    <include domain="database" path="security_cam.db" />

    <!-- Exclude sensitive credentials shared preferences from plain backup -->
    <exclude domain="sharedpref" path="security_cam_credentials.xml" />
    <exclude domain="sharedpref" path="security_cam_secure_prefs.xml" />
</full-backup-content>
