<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up ordinary settings and the event database -->
    <include domain="sharedpref" path="." />
    <include domain="database" path="security_cam.db" />

    <!-- Never back up the files that hold SMTP credentials -->
    <exclude domain="sharedpref" path="security_cam_credentials.xml" />
    <exclude domain="sharedpref" path="security_cam_secure_prefs.xml" />
</full-backup-content>
